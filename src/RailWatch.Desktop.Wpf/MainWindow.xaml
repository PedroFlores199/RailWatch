<Window x:Class="RailWatch.Desktop.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RailWatch · Centro de control" Width="1360" Height="850" MinWidth="1050" MinHeight="650" Background="#F4F7F9" FontFamily="Segoe UI" Foreground="#294357" WindowStartupLocation="CenterScreen">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#17541F"><DockPanel Margin="23,30"><StackPanel DockPanel.Dock="Top"><TextBlock Text="≋ RailWatch" FontFamily="Segoe UI" FontSize="26" Foreground="White"/><TextBlock Text="Control ferroviario" Foreground="#91A7B8" FontSize="9" Margin="4,10,0,40"/><TextBlock Text="Centro de control" FontSize="9" Foreground="#BCA275"/><TextBlock Text="Red ferroviaria española" Foreground="#D3DFE8" FontSize="13" Margin="0,12,0,7"/><TextBlock Text="Seguimiento de operaciones" Foreground="#819CAE" FontSize="11"/></StackPanel><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Pedro Flores" Foreground="White" FontSize="12"/><TextBlock Text="C# / .NET · WPF / MVVM" Foreground="#7C98AC" FontSize="10" Margin="0,7,0,0"/></StackPanel></DockPanel></Border>
        <Grid Grid.Column="1" Margin="30,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Red de Cercanías" Foreground="#AA9169" FontSize="10"/><TextBlock Text="Centro de control ferroviario" FontFamily="Segoe UI" FontSize="26" Margin="0,13,0,10"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="#8B9EAD"/></StackPanel><Button Grid.Column="1" Content="Exportar a Excel" VerticalAlignment="Center" Click="Export_Click"/></Grid>
            <Grid Grid.Row="1" Margin="0,25,0,25"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#DFE7ED" BorderThickness="1" Padding="20" Margin="0,0,15,0"><StackPanel><TextBlock Text="Trenes en seguimiento" FontSize="11" Foreground="#94A5B3"/><TextBlock Text="{Binding TrainCount}" FontSize="35" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#DFE7ED" BorderThickness="1" Padding="20" Margin="0,0,15,0"><StackPanel><TextBlock Text="Puntualidad observada (≤ 5 min)" FontSize="11" Foreground="#94A5B3"/><TextBlock Text="{Binding Punctuality, TargetNullValue=Sin datos, StringFormat={}{0:0.0}%}" FontSize="35" Margin="0,10,0,0" Foreground="#618D78"/></StackPanel></Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#DFE7ED" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="Alertas de retraso" FontSize="11" Foreground="#94A5B3"/><TextBlock Text="{Binding Alerts.Count}" FontSize="35" Margin="0,10,0,0" Foreground="#B49762"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,15"><TextBlock Text="Trenes en circulación" FontSize="17" VerticalAlignment="Center"/><TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="230" Padding="9" HorizontalAlignment="Right" ToolTip="Buscar tren, línea o estación"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Trains}"><DataGrid.Columns><DataGridTextColumn Header="Tren" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="Línea" Binding="{Binding Line}" Width="65"/><DataGridTextColumn Header="Próxima estación" Binding="{Binding NextStop}" Width="*"/><DataGridTextColumn Header="Retraso (s)" Binding="{Binding DelaySeconds, TargetNullValue=Sin dato}" Width="85"/><DataGridTextColumn Header="Predicción (min)" Binding="{Binding PredictedDelayMinutes, StringFormat=0.0, TargetNullValue=Sin modelo}" Width="105"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="Sin dato indica que el proveedor no informa del retraso. Replay identifica una grabación, no circulación actual." Foreground="#96A8B6" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/></Grid>
                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,15"><TextBlock Text="Alertas en directo" FontSize="17"/><CheckBox Content="Sonido" IsChecked="{Binding SoundEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/></DockPanel><ListBox Grid.Row="1" ItemsSource="{Binding Alerts}" BorderBrush="#DFE7ED" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#EDF1F3" BorderThickness="0,0,0,1" Padding="10,14"><StackPanel><TextBlock Text="{Binding Line}" Foreground="#B69661" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding At, StringFormat=HH:mm:ss}" FontSize="9" Foreground="#A6B5BF" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Margin="0,20,0,0"><TextBlock Text="Puntualidad por línea" FontSize="14" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Line}" FontSize="10"/><ProgressBar Grid.Column="1" Value="{Binding Punctuality}" Maximum="100" Height="7" Foreground="#78A28C" Background="#E7EDF1"/><TextBlock Grid.Column="2" Text="{Binding Punctuality, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="10"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid>
            </Grid>
            <TextBlock Grid.Row="3" Text="Datos: Renfe Open Data · CC BY 4.0 / RailWatch · Centro de operaciones" Foreground="#A4B2BD" FontSize="10" Margin="0,25,0,0"/>
        </Grid>
    </Grid>
</Window>
